<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111e">

    <!-- Substituído para a câmara do ZXing funcionar perfeitamente -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/scannerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Camada de Interface Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Topo com fechar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escanear QR Code"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:layout_alignParentEnd="true"
                android:tint="#FFFFFF" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEITURA DE ACESSO"
            android:textColor="#8899a6"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aponte a câmera para o QR Code do usuário"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="40dp" />

        <!-- Moldura Central de Foco -->
        <ImageView
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/bg_input_field"
            android:padding="20dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mantenha o código dentro da moldura"
            android:textColor="#8899a6"
            android:textSize="12sp"
            android:layout_marginBottom="40dp" />

        <!-- Botão da Lanterna -->
        <ToggleButton
            android:id="@+id/btnFlash"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_field"
            android:textOff=""
            android:textOn=""
            android:drawableTop="@android:drawable/ic_menu_camera"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lanterna desligada"
            android:textColor="#8899a6"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use apenas para identificar o crachá."
            android:textColor="#556677"
            android:textSize="11sp" />

    </LinearLayout>

</RelativeLayout>