<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Meu crachá"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Cartão do Crachá Digital -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <!-- Topo do Crachá -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Crachá Digital de Acesso"
                    android:textColor="#8899a6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/presence_online"
                    app:tint="#4CAF50" />
            </LinearLayout>

            <!-- Foto de Perfil (Placeholder) -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_info_box"
                android:src="@android:drawable/ic_menu_myplaces"
                android:padding="12dp"
                app:tint="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Nome Dinâmico -->
            <TextView
                android:id="@+id/txtNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Usuário"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Empresa/Cargo Dinâmico -->
            <TextView
                android:id="@+id/txtEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empresa · Cargo"
                android:textColor="#8899a6"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Imagem do QR Code Gerado -->
            <ImageView
                android:id="@+id/imgQrCode"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Badge Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ QR Code Válido / Fixo"
                android:textColor="#007AFF"
                android:background="#10233f"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apresente este código na portaria na entrada e na saída."
            android:textColor="#8899a6"
            android:textSize="12sp"
            android:textAlignment="center"
            android:layout_marginBottom="20dp" />

        <!-- Botões de Ação -->
        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Salvar QR Code na Galeria"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#10233f"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnCompartilhar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Compartilhar Crachá"
            android:textColor="#07111e"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#FFFFFF"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>